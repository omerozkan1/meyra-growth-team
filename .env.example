# Copy to .env (git-ignored) and fill in. Never commit real values.
# App Store campaign links: provider token (App Store Connect > Analytics > Campaigns > Generate link -> "pt" value)
MEYRA_APPLE_PT=
# Future read-only integrations (leave empty until the owner connects them)
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=   # path to a read-only service-account JSON stored OUTSIDE this repo
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=             # path to .p8 stored OUTSIDE this repo
PLAY_REPORTS_BUCKET=              # gs://pubsite_prod_... (Play Console > Download reports)
YOUTUBE_CHANNEL_ID=
